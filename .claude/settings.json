{
  "permissions": {
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push*:main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git push*--delete*)",
      "Bash(git push origin :*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/session-status.sh",
            "timeout": 45,
            "statusMessage": "controllo stato repo..."
          }
        ]
      }
    ]
  }
}
